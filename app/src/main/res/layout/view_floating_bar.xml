<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_bar_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_bar"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Drag Handle / Logo -->
        <TextView
            android:id="@+id/btn_float_drag"
            android:layout_width="28dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⋮⋮"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Play / Pause Button -->
        <ImageButton
            android:id="@+id/btn_float_play"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:contentDescription="Play/Pause"
            android:padding="6dp"
            android:src="@drawable/ic_play" />

        <!-- Add Target Point -->
        <ImageButton
            android:id="@+id/btn_float_add"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:contentDescription="Add Target"
            android:padding="6dp"
            android:src="@drawable/ic_add" />

        <!-- Remove Target Point -->
        <ImageButton
            android:id="@+id/btn_float_remove"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:contentDescription="Remove Target"
            android:padding="6dp"
            android:src="@drawable/ic_remove" />

        <!-- Floating Millisecond Clock Toggle -->
        <ImageButton
            android:id="@+id/btn_float_clock"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:contentDescription="Toggle Clock"
            android:padding="6dp"
            android:src="@drawable/ic_clock" />

        <!-- Click Interval / Speed Settings -->
        <ImageButton
            android:id="@+id/btn_float_settings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:contentDescription="Speed Settings"
            android:padding="6dp"
            android:src="@drawable/ic_settings" />

        <!-- Close Floating Bar -->
        <ImageButton
            android:id="@+id/btn_float_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@android:color/transparent"
            android:contentDescription="Close"
            android:padding="6dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Inline status line: state / countdown / dispatch stats -->
    <TextView
        android:id="@+id/tv_float_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="3dp"
        android:text="待命"
        android:textColor="@color/text_secondary"
        android:textSize="9sp" />

</LinearLayout>
