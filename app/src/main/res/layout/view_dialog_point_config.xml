<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="标靶 ① 点击间隔"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_dialog_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:padding="4dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:text="设置点击此位置后的等待时间"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Stepper Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_step_minus"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_secondary"
            android:text="-10"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_interval_value"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:fontFamily="monospace"
            android:text="50 ms"
            android:textColor="@color/accent_purple"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_step_plus"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_secondary"
            android:text="+10"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_quick_30"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_button_secondary"
            android:text="30ms"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_quick_50"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_button_secondary"
            android:text="50ms"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_quick_100"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/bg_button_secondary"
            android:text="100ms"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btn_quick_200"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="200ms"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Save Button -->
    <Button
        android:id="@+id/btn_dialog_save"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_primary"
        android:text="保存配置"
        android:textColor="@color/on_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
